{
  "name": "chifa-yemheng",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend -- --host",
    "dev:backend": "npm run dev --workspace=@chifa-yemheng/backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=@chifa-yemheng/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
