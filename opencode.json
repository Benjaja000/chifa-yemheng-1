    "stitch": {
      "type": "local",
      "command": ["npx", "-y", "stitch-mcp-server@latest"],
      "environment": {
        "STITCH_API_KEY": "{file:.secrets/stitch-key.md}"
      },
      "enabled": true,
      "timeout": 300000
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=jslpzwdtaggfclnbmrmt&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    }
  },
  "provider": {
