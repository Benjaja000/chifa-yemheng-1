        "apiKey": "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"
      },
      "models": {
        "deepseek-ai/deepseek-v3.1": {
